#!/bin/bash
#
# Make VM network - configure networking on this machine for VMs.
#
# This script assumes that on this host NAT is only used for guest VMs.  Expect
# problems if the host normally engages in NAT for other reasons.
#
# The host for test VMs probably should not have a corresponding test VM.  If
# it is possible, it will probably require some extra network logic.
#
# Consider enabling routing with ansible, permanently.
#   Edit/template:  /etc/sysctl.conf
#   sysctl -p
#
# iptables rules are added and removed by rule specification.  It might be
# better to remove rule numbers.  It might also be better to try to use -F to
# flush all matches instead of -D to delete the first match.

mode="${1}"
host_external_interface="$(ip route | awk '/^default/ {print $5}')"
host_external_ip_address="$(ip addr | awk -F '[ /]+' '/inet / {print $3}' | grep -v '^127\.0\.0\.1$' | head -n 1)"
# Pull gateway address and subnet from ansible inventory.
host_internal_ip_address='192.168.11.1'
host_internal_subnet_bits='24'
testvm_ssh_client='testvm-ssh-client'



function main() {
  # Test VM interface number is expected to be the SSH unique port number.
  interface_number="${INTERFACE_NUMBER}"
  if ! grep -qE '^[0-9]+$' <<< "${interface_number}"; then
    fail "Invalid interface number:  '${interface_number}'"
  fi
  interface=tap"${interface_number}"
  ip_address="${IP_ADDRESS}"
  dec_byte='([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])'
  if ! grep -qE "^${dec_byte}\.${dec_byte}\.${dec_byte}\.${dec_byte}\$" <<< "${ip_address}"; then
    fail "Invalid IP address:  '${ip_address}'"
  fi

  case "${mode}" in
    'down')
      down
      ;;
    '')
      ;&
    'up')
      up
      ;;
    *)
      fail "Unknown mode:  '${mode}'"
      ;;
  esac
}


function up() {
  # Routing from host to internet gets broken when any test VM is up.

  cat > /proc/sys/net/ipv4/ip_forward <<< '1' || fail "Failed to enable IP forwarding."

  ip tuntap add "${interface}" mode tap || fail "Failed to add TAP interface."
  ip address add "${host_internal_ip_address}/${host_internal_subnet_bits}" dev "${interface}" noprefixroute || fail "Failed to configure TAP interface."
  ip link set "${interface}" up || fail "Failed to bring up TAP interface."

  # It would be better to refrain from creating this route than to remove it like this.
  ip route del table local "${host_internal_ip_address}" dev "${interface}"

  iptables -t nat -A POSTROUTING -s "${ip_address}" -o "${host_external_interface}" -j SNAT --to-source "${host_external_ip_address}" || fail "Failed to configure NAT."

  # This doesn't seem to be working.  Is it necessary?
  #iptables -t mangle -A POSTROUTING -s "${ip_address}" -o "${host_external_interface}" -j MARK --set-mark "${interface_number}" || fail "Failed to mark packets from test VM." 

  iptables -t mangle -A OUTPUT -m owner --uid-owner "${testvm_ssh_client}" -d "${ip_address}" -j MARK --set-mark "${interface_number}" || fail "Failed to mark packets from SSH client user to test VM."
  ip rule add fwmark "${interface_number}" table "${interface_number}" || fail "Failed to set rule for marked packets from test VM SSH client user."

  # If src is specified, this yields:  "Error: Invalid prefsrc address."
  ip route add "${ip_address}" dev "${interface}" table "${interface_number}" || fail "Failed to add route for marked packets from test VM SSH client user."

  # I feel like there might be a need for another rule, here, to handle marked packets from the VM.  Review.
  
  ip route flush cache || fail "Failed to flush route cache."
}


function down() {
  ip route del "${ip_address}" dev "${interface}" table "${interface_number}" || fail "Failed to remove route for marked packets from test VM SSH client user."
  ip rule del fwmark "${interface_number}" table "${interface_number}" || fail "Failed to set rule for marked packets from test VM SSH client user."
  iptables -t mangle -D OUTPUT -m owner --uid-owner "${testvm_ssh_client}" -d "${ip_address}" -j MARK --set-mark "${interface_number}" || fail "Failed to unmark packets from SSH client user to test VM."
  # iptables -t mangle -D POSTROUTING -s "${ip_address}" -o "${host_external_interface}" -j MARK --set-mark "${interface_number}" || fail "Failed to unmark packets from test VM."
  iptables -t nat -D POSTROUTING -s "${ip_address}" -o "${host_external_interface}" -j SNAT --to-source "${host_external_ip_address}" || fail "Failed to deconfigure NAT."
  ip link delete "${interface}" || fail "Failed to delete TAP interface:  '${interface}'"

  ip route flush cache || fail "Failed to flush route cache."
}


function fail() {
  printf 'ERROR:  %s\n' "${1}" >&2
  exit "${2:-1}"
}


main
