#!/bin/bash
#
# mkvm <hostname>




function main() {
  self_name="${0##*/}"
  self_path="${0%/*}"

  control_center="${self_path}/../.."
  os_deployment="${control_center}/os-deployment"

  inventory_repo="${control_center}/ansible-inventory"
  inventory="${inventory_repo}/inventory.d"
  host_vars="${inventory}/host_vars/${hostname}.yml"
  host_files="${inventory_repo}/hosts/${hostname}/files"

  sensitive_inventory_repo="${control_center}/sensitive-ansible-inventory"
  sensitive_inventory="${sensitive_inventory_repo}/inventory.d"
  sensitive_host_vars="${sensitive_inventory}/host_vars/${hostname}.yml"
  sensitive_host_files="${sensitive_inventory_repo}/hosts/${hostname}/files"

  # domain should come from inventory.
  domain='neuronpointer.net'
  #installer_images_original='/storage/bittorrent/content'
  installer_images_original=~/tmp
  # Without network, netinst does not even install sshd.
  #installer_type='netinst'
  installer_type='DVD-1'
  #arch='armhf'
  arch='amd64'
  os='debian'
  release='trixie'
  version='13.5.0'
  mem_gb='4'
  mem_mb="$(( mem_gb * 1024 ))"
  vm_image_size='10G'
  cpu_core_count=4
  subnet_with_mask="192.168.11.0/24"
  gateway="192.168.11.1"
  cpu_model='Broadwell-v4'
  mcast='230.0.0.1:1234'
  ifname='eth0'
  local_net_id='vmnet'
  upstream_net_id='upnet'

  if ! test 1 = "${#}"; then
    fail "Wrong number of arguments.  Just specify a short hostname."
  fi
  hostname="${1}"

  mac_address="$(awk '/^mac_address/ {print $2}' "${host_vars}" | head -n 1 | sed "s/['\"]//g")"
  hex_byte='[a-fA-F0-9]{2}'
  if ! grep -qE "^${hex_byte}:${hex_byte}:${hex_byte}:${hex_byte}:${hex_byte}:${hex_byte}\$" <<< "${mac_address}"; then
    fail "Invalid MAC address:  '${mac_address}'"
  fi
  ip_address="$(awk '/^ip_address/ {print $2}' "${host_vars}" | head -n 1 | sed "s/['\"]//g")"
  dec_byte='([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])'
  if ! grep -qE "^${dec_byte}\.${dec_byte}\.${dec_byte}\.${dec_byte}\$" <<< "${ip_address}"; then
    fail "Invalid IP address:  '${ip_address}'"
  fi
  ssh_unique_port="$(awk '/^ssh_unique_port/ {print $2}' "${host_vars}" | head -n 1 | sed "s/['\"]//g")"
  if ! grep -qE '^[0-9]+$' <<< "${ssh_unique_port}"; then
    fail "Invalid SSH unique port number:  '${ssh_unique_port}'"
  fi


  case "${arch}" in
    'i386')
      initrd_path='install.386'
      ;;
    'amd64')
      initrd_path='install.amd'
      ;;
    *)
      fail "Unrecognized architecture:  '${arch}'"
      ;;
  esac

  pass_path="aaron/${hostname}/root"
  pass_file=~/.password-store/"${pass_path}".gpg
  ssh_host_key_private_file="${sensitive_host_files}/ssh_keys/ssh_host_rsa_key"
  ssh_host_key_public_file="${host_files}/ssh_keys/ssh_host_rsa_key.pub"
  lock_parent_dir=~/.mkvm/locks
  lock_path="${lock_parent_dir}"/"${hostname}"
  success_dir=~/.mkvm/success/"${hostname}"
  success_file_preseed="${success_dir}/preseed"
  success_file_installer_image="${success_dir}/installer_image"
  success_file_vm_image="${success_dir}/vm_image"
  preseed_template_dir="${os_deployment}/preseed"
  preseed_template_file="${preseed_template_dir}/${arch}-${os}-${release}.cfg"
  preseed_generated_dir=~/.mkvm/preseed/"${hostname}"
  # I think this has to be named "preseed.cfg".
  preseed_generated_file="${preseed_generated_dir}/preseed.cfg"
  installer_images_generated=~/.mkvm/installer_images_generated
  installer_image_name_original="${os}-${version}-${arch}-${installer_type}.iso"
  installer_image_original="${installer_images_original}/${installer_image_name_original}"
  installer_image_name_generated="${hostname}.${installer_image_name_original}"
  installer_image_generated="${installer_images_generated}/${installer_image_name_generated}"
  unpack=~/.mkvm/"installer_unpack/${installer_image_name_generated}"
  vm_image_clean_dir=~/.mkvm/vm_images_clean
  vm_image_clean="${vm_image_clean_dir}/${hostname}.qcow"
  vm_image_used_dir=~/.mkvm/vm_images_used
  vm_image_used="${vm_image_used_dir}/${hostname}.qcow"

  case "${self_name}" in
    mkvm)
      mkvm
      ;;
    sshvm)
      sshvm root@"staging-${hostname}"
      ;;
    *)
      fail "I don't know how to be '${self_name}'."
  esac
}


function mkvm() {
  create_directories
  info "Locking."
  lock
  remove_stale_files
  generate_preseed
  generate_installer_image
  generate_vm_image
  launch_vm
  info "Unlocking."
  unlock
}


function lock() {
  if ! mkdir "${lock_path}"; then
    error "Lock held by PID:"
    cat "${lock_path}"/pid >&2
    fail "Lock already held for host:  '${hostname}'"
  fi
  echo $$ > "${lock_path}"/pid
}


function unlock() {
  rm -rf "${lock_path}" || error "Failed to remove lock."
}


function remove_stale_files() {
  # In bash, the "test" builtin, when comparing age of files with "-nt" or
  # "-ot", considers any existing file to be newer than any missing file, and no
  # error is raised for comparing the age of a missing file.  Explicitly check
  # existence separately.
  info "Removing any stale files."
  if 
    ! test -e "${success_file_preseed}" \
    || ! test -e "${preseed_template_file}" \
    || ! test "${preseed_generated_file}" -nt "${preseed_template_file}" \
    || ! test -e "${pass_file}" \
    || ! test "${preseed_generated_file}" -nt "${pass_file}" \
    || ! test -e "${ssh_host_key_private_file}" \
    || ! test "${preseed_generated_file}" -nt "${ssh_host_key_private_file}" \
    || ! test -e "${ssh_host_key_public_file}" \
    || ! test "${preseed_generated_file}" -nt "${ssh_host_key_public_file}"
  then
    rm -f "${preseed_generated_file}" || fail "Failed to remove stale generated preseed."
  fi

  if
    ! test -e "${success_file_installer_image}" \
    || ! test -e "${preseed_generated_file}" \
    || ! test "${installer_image_generated}" -nt "${preseed_generated_file}" \
    || ! test -e "${installer_image_original}" \
    || ! test "${installer_image_generated}" -nt "${installer_image_original}"
  then
    rm -f "${installer_image_generated}" || fail "Failed to remove stale generated installer image."
  fi

  if
    ! test -e "${success_file_vm_image}" \
    || ! test -e "${installer_image_generated}" \
    || ! test "${vm_image_clean}" -nt "${installer_image_generated}"
  then
    rm -f "${vm_image_clean}" || fail "Failed to remove stale clean VM image."
  fi

  # Unconditionally remove used image along with any untracked changes it may contain.
  rm -f "${vm_image_used}" || fail "Failed to remove stale used VM image."
}


function create_directories() {
  info "Creating directories."
  mkdir -p "${lock_parent_dir}" || fail "Failed to create lock directory:  '${lock_parent_dir}'"
  mkdir -p "${success_dir}" || fail "Failed to create success directory:  '${success_dir}'"
  mkdir -p "${preseed_generated_dir}" || fail "Failed to create preseed directory:  '${preseed_dir}'"
  mkdir -p "${unpack}" || fail "Failed to create installer unpack directory:  '${unpack}'"
  mkdir -p "${vm_image_clean_dir}" || fail "Failed to create images directory:  '${vm_image_clean_dir}'"
  mkdir -p "${vm_image_used_dir}" || fail "Failed to create images directory:  '${vm_image_clean_dir}'"
  mkdir -p "${installer_images_generated}" || fail "Failed to create images directory:  '${vm_image_clean_dir}'"
}


function generate_preseed() {
  if test -e "${preseed_generated_file}"; then
    info "Generated preseed file is already present."
    return 0
  fi
  rm -f "${success_file_preseed}" || fail "Failed to remove success declaration for preseed file."

  info "Generating preseed file."
  cp "${preseed_template_file}" "${preseed_generated_file}" || fail "Failed to copy preseed file."

  if test 'gateway' = "${hostname}"; then
    cat "${preseed_template_dir}/gateway/late.txt" >> "${preseed_generated_file}" || fail "Failed to add late commands for gateway."
  else
    cat "${preseed_template_dir}/non-gateway/late.txt" >> "${preseed_generated_file}" || fail "Failed to add late commands for non-gateway."
  fi
  echo '  true;' >> "${preseed_generated_file}" || fail "Failed to terminate late command string."
  if test 'gateway' = "${hostname}"; then
    cat "${preseed_template_dir}/gateway/netcfg.txt" >> "${preseed_generated_file}" || fail "Failed to add netcfg configuration for gateway."
  else
    cat "${preseed_template_dir}/non-gateway/netcfg.txt" >> "${preseed_generated_file}" || fail "Failed to add netcfg configuration for non-gateway."
  fi

  sed -i "s/password unspecified-password\$/password $(pass show "${pass_path}")/" "${preseed_generated_file}" || fail "Failed to inject password into preseed file."

  # "BEGIN RSA PRIVATE KEY" != "BEGIN OPENSSH PRIVATE KEY" != "BEGIN PRIVATE
  # KEY".  sshd can handle any of those, but only if the begin and end lines
  # match the key encoding.  Identify the begin line, the end line, and the
  # encoded key, and inject all of those into the preseed file.
  ssh_host_key_private_begin="$(
    grep -- '-----' "${ssh_host_key_private_file}" | head -n 1
  )" || fail "Failed to read SSH private key begin line."
  ssh_host_key_private_body="$(
    while read line; do 
      if ! grep -q -- '-----' <<< "${line}"; then 
        # Strip newlines to facilitate injection into the preseed file.
        printf "%s" "${line}"
      fi
    done < "${ssh_host_key_private_file}"
  )" || fail "Failed to read SSH private key."
  ssh_host_key_private_end="$(
    grep -- '-----' "${ssh_host_key_private_file}" | tail -n 1
  )" || fail "Failed to read SSH private key begin line."

  sed -i "s#ssh_host_key_private_begin#${ssh_host_key_private_begin}#" "${preseed_generated_file}" || fail "Failed to inject SSH private key begin line into preseed file."
  sed -i "s#ssh_host_key_private_body#${ssh_host_key_private_body}#" "${preseed_generated_file}" || fail "Failed to inject SSH private key body into preseed file."
  sed -i "s#ssh_host_key_private_end#${ssh_host_key_private_end}#" "${preseed_generated_file}" || fail "Failed to inject SSH private key end line into preseed file."

  ssh_host_key_public="$(cat "${ssh_host_key_public_file}")" || fail "Failed to read SSH public key."
  sed -i "s#ssh_host_key_public#${ssh_host_key_public}#" "${preseed_generated_file}" || fail "Failed to inject SSH public key into preseed file."
  ssh_authorized_key="$(cat ~/.ssh/id_rsa.pub)" || fail "Failed to read SSH authorized key (this user's public key)."
  sed -i "s#ssh_authorized_key#${ssh_authorized_key}#" "${preseed_generated_file}" || fail "Failed to inject SSH authorized key into preseed file."
  touch "${success_file_preseed}" || fail "Failed to declare success after generating preseed file."
  sed -i "s/ip_address\$/${ip_address}/" "${preseed_generated_file}" || fail "Failed to inject IP address into preseed file."
  sed -i "s/unassigned-hostname\$/${hostname}/" "${preseed_generated_file}" || fail "Failed to inject hostname into preseed file."
  sed -i "s/unassigned-domain\$/${domain}/" "${preseed_generated_file}" || fail "Failed to inject domain into preseed file."
}


function generate_installer_image() {
  if test -e "${installer_image_generated}"; then
    info "Generated installer image is already present."
    return 0
  fi
  rm -f "${success_file_installer_image}" || fail "Failed to remove success declaration for installer image."
  info "Generating installer image."
  unpack_image
  unpack_initrd
  inject_preseed
  repack_initrd
  configure_boot
  regenerate_checksums
  repack_image
  touch "${success_file_installer_image}" || fail "Failed to declare success after generating installer image."
}


function generate_vm_image() {
  if test -e "${vm_image_clean}"; then
    info "Clean VM image is already present."
    return 0
  fi
  rm -f "${success_file_vm_image}" || fail "Failed to remove success declaration for clean VM image."
  info "Generating clean VM image."
  initialize_vm_image
  install_os
  touch "${success_file_vm_image}" || fail "Failed to declare success after generating clean VM image."
}


function launch_vm() {
  if ! test "${vm_image_used}" -nt "${vm_image_clean}"; then
    cp "${vm_image_clean}" "${vm_image_used}" || fail "Failed to copy clean VM image to used VM image."
  fi
  info "Launching VM."
  boot_this_image "${vm_image_used}"
  info "VM is down."
}


# boot_this_image <vm_image_file>
boot_this_image() {
  # What happens if there is no mcast specification?
  # Can interface name (visible to OS) be specified for virtio-net-pci?
  image_file="${1}"

  # The first network interface will be labeled ens3, and the second will be
  # ens4.  The preseed template specifies ens3 as the interface to configure.
  net_args=()
  if test 'gateway' = "${hostname}"; then
  net_args+=(
    -netdev user,id="${upstream_net_id}",hostfwd=::"${ssh_unique_port}"-:22
    -device virtio-net-pci,netdev="${upstream_net_id}"
  )
  fi
  net_args+=(
    -device virtio-net-pci,netdev="${local_net_id}",mac="${mac_address}"
    -netdev socket,id="${local_net_id}",mcast="${mcast}"
  )
  shift 1

  qemu-system-x86_64 \
    -name "${vm}" \
    -machine accel=kvm \
    -cpu "${cpu_model}" \
    -smp cores="${cpu_core_count}" \
    -m "${mem_mb}" \
    "${net_args[@]}" \
    -vga virtio \
    -display none \
    "${image_file}" \
    "${@}" \
  ;
}


function wait_for_ssh() {
  while 
    ! sshvm root@staging-"${host}" whoami > /dev/null 2>&1
  do
    echo -n '.'
    sleep 1
  done
}


function sshvm() {
  sshpass \
    -d 3 \
    ssh \
      "${@}" \
    3< <(pass show "${pass_path}")
}


function unpack_image() {
  if test -e "${unpack}"; then
    chmod -R u+rwX "${unpack}" || fail "Failed to prepare installer unpack directory for deletion:  '${unpack}'"
    rm -rf "${unpack}" || fail "Failed to remove installer unpack directory:  '${unpack}'"
  fi
  7z x -o"${unpack}/" "${installer_image_original}" || fail "Failed to unpack installer image:  '${installer_image_generated}'"
}


function unpack_initrd() {
  chmod +w -R "${unpack}/${initrd_path}"/ || fail "Failed to set write permission for initrd file."
  gunzip "${unpack}/${initrd_path}"/initrd.gz || fail "Failed to unpack initrd file."
}


function inject_preseed() {
  cd "${preseed_generated_dir}" || fail "Failed to enter path to generated preseed."
  cpio -o -H newc -A -F "${unpack}/${initrd_path}/initrd" <<< preseed.cfg || fail "Failed to append preseed file to initrd file."
}


function repack_initrd() {
  gzip "${unpack}/${initrd_path}"/initrd || fail "Failed to repack initrd file."
  chmod -w -R "${unpack}/${initrd_path}"/ || fail "Failed to revoke write permission for initrd file."
}


function configure_boot() {
  sed -i '/include gtk/ {d};' "${unpack}"/isolinux/menu.cfg || fail "Failed to remove GTK installer boot option."
  sed -i '/include spk/ {d};' "${unpack}"/isolinux/menu.cfg || fail "Failed to remove speech synthesis features from boot menu."
  sed -i -E 's/^(label install)/default install\n\1/' "${unpack}"/isolinux/txt.cfg || fail "Failed to make non-graphical installer boot option default."
  echo 'timeout 10' >> "${unpack}/isolinux/txt.cfg" || fail "Failed to add timeout option to boot menu."
}


function regenerate_checksums() {
  cd "${unpack}" || fail "Failed to enter installer unpack directory:  '${unpack}'"
  alg='md5'
  checksum="${alg}sum"
  checksum_file="${checksum}.txt"
  chmod +w "${checksum_file}" || fail "Failed to set write permission on checksum file:  '${checksum_file}'"
  find -follow -type f ! -name "${checksum_file}" -print0 | xargs -0 "${checksum}" > "${checksum_file}"
  chmod -w "${checksum_file}" || fail "Failed to revoke write permissions on checksum file:  '${checksum_file}'"
  cd "${OLDPWD}" || fail "Failed to exit installer unpack directory."
}


function repack_image() {
  genisoimage \
    -r -J \
    -b "isolinux/isolinux.bin" \
    -c "isolinux/boot.cat" \
    -no-emul-boot \
    -boot-load-size 4 \
    -boot-info-table \
    -o "${installer_image_generated}" \
    "${unpack}/" \
    || fail "Failed to generate installer image:  '${installer_image_generated}'"

  isohybrid "${installer_image_generated}" || fail "Failed to make installer image bootable:  '${installer_image_generated}'"
}


function initialize_vm_image() {
  info "Initializing clean VM image."
  qemu-img create -f qcow2 "${vm_image_clean}" "${vm_image_size}" || fail "Failed to create target disk image:  '${vm_image_clean}'"
}


function install_os() {
  info "Installing OS to clean VM image."
  boot_this_image "${vm_image_clean}" \
    -cdrom "${installer_image_generated}" \
    -boot once=d \
    || fail "Failed to install OS to clean VM image."
}


function fail() {
  error "${1}"
  unlock
  exit "${2:-1}"
}


function error() {
  printf '%s\n' "${1}" >&2
}


function info() {
  printf '%s\n' "${1}"
}


main "${@}"
