[connection]
id=${wireless_interface}
#uuid=${uuid}
type=wifi
interface-name=${wireless_interface}

[wifi]
mode=infrastructure
ssid=${network-name}

[wifi-security]
key-mgmt=wpa-psk
psk=${wpa_psk}

[ipv4]
address1=${ip_address}/${netmask_bits},${gateway}
dns=${dns_server};
method=manual

[ipv6]
addr-gen-mode=default
method=auto

[proxy]
